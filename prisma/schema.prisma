generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(uuid())
  name             String
  email            String    @unique
  phone            String
  role             Role      @default(DRIVER)
  passwordHash     String    @map("password_hash")
  isActive         Boolean   @default(true) @map("is_active")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  assignedVehicle  String?    @unique @map("assigned_vehicle")
  assignedToAdmin  String?    @map("assigned_to_admin")
  
  vehicle          Vehicle?   @relation("DriverVehicle", fields: [assignedVehicle], references: [id], onDelete: SetNull)
  admin            User?      @relation("AdminDrivers", fields: [assignedToAdmin], references: [id], onDelete: SetNull)
  
  managedVehicles  Vehicle[] @relation("AdminVehicles")
  managedDrivers   User[]    @relation("AdminDrivers")
  
  logs             Log[]
  fuelRecords      FuelRecord[]
  incomes          Income[]
  expenses         Expense[]
  reportTemplates  ReportTemplate[]
  
  adminSubscription Subscription? @relation("AdminSubscription")
  adminPayments     SubscriptionPayment[] @relation("AdminPayments")

  syncQueues        SyncQueue[]   @relation("SyncQueue")
  syncBatches       SyncBatch[]   @relation("SyncBatch")
  @@map("users")
}

model Vehicle {
  id        String   @id @default(uuid())
  regNo     String   @unique @map("reg_no")
  model     String?
  fuelType  String   @map("fuel_type")
  lastKm    Int      @map("last_km")
  createdAt DateTime @default(now()) @map("created_at")
  
  logs      Log[]
  driver    User?    @relation("DriverVehicle")

  assignedToAdmin  String?    @map("assigned_to_admin")
  admin            User?      @relation("AdminVehicles", fields: [assignedToAdmin], references: [id])
  
  @@map("vehicles")
}

model Log {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  vehicleId  String    @map("vehicle_id")
  date       DateTime
  recordType RecordType @map("record_type")
  value      Float     @default(0)
  synced     Boolean   @default(false)
  createdAt  DateTime  @default(now()) @map("created_at")

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle    Vehicle   @relation(fields: [vehicleId], references: [id])

  @@map("logs")
}

model FuelRecord {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  date      DateTime
  kmAtFill  Float    @map("km_at_fill")
  gasKg     Float    @map("gas_kg")
  costInr   Float    @map("cost_inr")
  photoUrl  String?  @map("photo_url")
  synced    Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fuel_records")
}

model Income {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  categoryId String   @map("category_id")
  date       DateTime
  amount     Float
  photoUrl   String?  @map("photo_url")
  synced     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id])

  @@map("incomes")
}

model Expense {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  typeId      String   @map("type_id")
  subTypeId   String   @map("sub_type_id")
  date        DateTime
  amount      Float
  description String?
  photoUrl    String?  @map("photo_url")
  synced      Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        Category @relation("ExpenseType", fields: [typeId], references: [id])
  subType     Category @relation("ExpenseSubType", fields: [subTypeId], references: [id])

  @@map("expenses")
}

model Category {
  id          String       @id @default(uuid())
  type        CategoryType
  name        String
  isActive    Boolean      @default(true) @map("is_active")
  createdBy   String       @map("created_by")
  createdAt   DateTime     @default(now()) @map("created_at")

  incomes     Income[]
  expenseTypes  Expense[] @relation("ExpenseType")
  expenseSubTypes Expense[] @relation("ExpenseSubType")

  @@unique([type, name])
  @@map("categories")
}

model ReportTemplate {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  template  String   // Handlebars/Mustache template string
  engine    String   @default("handlebars") // "handlebars" | "mustache"
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("report_templates")
}

model Subscription {
  id                      String               @id @default(uuid())
  adminId                 String               @unique @map("admin_id")
  plan                    String
  razorpaySubscriptionId  String               @unique @map("razorpay_subscription_id")
  razorpayCustomerId      String               @map("razorpay_customer_id")
  status                  String
  nextBillingAt           DateTime             @map("next_billing_at")
  activatedAt             DateTime             @map("activated_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  admin                   User                 @relation("AdminSubscription", fields: [adminId], references: [id], onDelete: Cascade)
  payments                SubscriptionPayment[]

  @@map("subscriptions")
}

model SubscriptionPayment {
  id                    String       @id @default(uuid())
  subscriptionId        String       @map("subscription_id")
  adminId               String       @map("admin_id")
  razorpayPaymentId     String       @unique @map("razorpay_payment_id")
  userCount             Int
  amount                Int
  currency              String
  status                String
  paidAt                DateTime     @map("paid_at")
  createdAt             DateTime     @default(now()) @map("created_at")

  admin                  User?        @relation("AdminPayments", fields: [adminId], references: [id], onDelete: Cascade)
  subscription          Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

enum Role {
  ADMIN
  DRIVER
}

enum RecordType {
  START
  END
}

model SyncBatch {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  batchId           String   @unique @map("batch_id")
  totalRecords      Int      @map("total_records")
  syncedRecords     Int      @default(0)           @map("synced_records")
  failedRecords     Int      @default(0)           @map("failed_records")
  status            String   @default("in_progress")
  startedAt         DateTime @default(now())      @map("started_at")
  completedAt       DateTime?                      @map("completed_at")
  createdAt         DateTime @default(now())      @map("created_at")

  user              User     @relation("SyncBatch", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([batchId])
  @@map("sync_batches")
}

model SyncQueue {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  batchId           String   @map("batch_id")
  recordType        String   @map("record_type")
  recordId          String   @map("record_id")
  status            String   @default("pending")
  retries           Int      @default(0)
  lastError         String?  @map("last_error")
  createdAt         DateTime @default(now())    @map("created_at")
  updatedAt         DateTime @updatedAt         @map("updated_at")

  user              User     @relation("SyncQueue", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([batchId, recordId])
  @@index([batchId])
  @@index([userId, status])
  @@map("sync_queue")
}

enum CategoryType {
  INCOME
  EXPENSE
  EXPENSE_TYPE
}
