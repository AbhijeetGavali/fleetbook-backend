# Database (PostgreSQL on cloud e.g. Supabase, Neon, Railway)
DATABASE_URL="postgresql://ideasprout:devpassword@localhost:5432/fleetbook"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=3000
NODE_ENV=development

CORS_ORIGIN=https://api-fleetbook.ideasprout.in,http://localhost:3000

# Gmail (Nodemailer)
GMAIL_USER="your-gmail@gmail.com"
GMAIL_APP_PASSWORD="your-16-char-app-password"
EMAIL_FROM_NAME="FleetBook"

# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID="your-phone-number-id"
WA_TOKEN="your-permanent-access-token"
WA_WEBHOOK_VERIFY_TOKEN="your-custom-verify-token"

# Razorpay subscription
RAZORPAY_API_KEY_ID="your-razorpay-key-id"
RAZORPAY_API_KEY_SECRET="your-razorpay-key-secret"
RAZORPAY_PLAN_MONTHLY_ID="plan_monthly_id_for_99_rs"
RAZORPAY_PLAN_ANNUAL_ID="plan_annual_id_for_999_rs"
RAZORPAY_WEBHOOK_SECRET="your-razorpay-webhook-secret"

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
